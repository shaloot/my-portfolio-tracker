# Copy to .env for LOCAL runs only (CI uses repo Variables/Secrets, not this file).
# All defaults are keyless - you only need this file if you switch providers.

# Price providers per market:  yfinance | bhavcopy (IN only) | twelvedata
PRICE_PROVIDER_IN=yfinance
PRICE_PROVIDER_US=yfinance

# News:  rss        FX:  yfinance | exchangerate_host
NEWS_PROVIDER=rss
FX_PROVIDER=yfinance

# Only needed if a provider above is set to twelvedata:
# TWELVEDATA_API_KEY=your_key_here
